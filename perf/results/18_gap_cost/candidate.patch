+// Parameter, CSI final byte, and encoded byte length. Share the choice between
+// gap pricing and emission so their estimates cannot use different commands.
+fn horizontal_cursor_command(from: usize, to: usize) -> (usize, char, usize) {
+    let delta = from.abs_diff(to);
+    let relative_len = if delta == 1 { 3 } else { 3 + decimal_len(delta) };
+    let column_len = if to == 1 { 3 } else { 3 + decimal_len(to) };
+    if relative_len < column_len {
+        (delta, if to > from { 'C' } else { 'D' }, relative_len)
+    } else {
+        (to, 'G', column_len)
+    }
+}
